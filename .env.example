# Public site URL (no trailing slash). Used for Open Graph, canonical URLs, sitemap, and robots.
# Set this to your deployed origin before sharing / judging (e.g. https://your-app.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: real scoring API base URL (no trailing slash). POST { address } to /score → WalletScoreResponse JSON.
# Leave unset to use built-in deterministic mock scores for demos.
# NEXT_PUBLIC_WALLET_SCORE_API_URL=https://your-api.example.com

# Recommended: one Alchemy API key for Ethereum + Base + Arbitrum (enable those networks on your Alchemy app).
# Copy from https://dashboard.alchemy.com — paste only the key string (not the full URL).
# NEXT_PUBLIC_ALCHEMY_API_KEY=

# Optional overrides (full URLs) if you do not use NEXT_PUBLIC_ALCHEMY_API_KEY:
# NEXT_PUBLIC_ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key
# NEXT_PUBLIC_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your-key
# NEXT_PUBLIC_ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/your-key
# Server-only Ethereum URL for /api/resolve-ens (falls back to NEXT_PUBLIC_* and Alchemy key if unset):
# ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key
